          implementation eq
// 20-sim Linear System Editor
// tf h 5.0e-4
parameters
	real hidden A [2, 2] = [0.0, 1.0; -1.0, 2.0];
	real hidden B [2, 1] = [0.0; -2.500000000000001e-8];
	real hidden C [1, 2] = [1.0, -0.0];
	real hidden x0 [2] = [0.0; 0.0];
variables
	real x [2];
equations
	next (x, x0) = A * x + B * u;
	y = C * x;
implementation_end;
