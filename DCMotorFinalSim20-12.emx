	p.u = R * p.i;
      implementation_end;
      Torque 1151.2 314.1
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Iconic Diagrams\Mechanical\Rotation\Actuators\Torque.emx</LibraryPath>
  <TimeStamp>2007-9-25 10:54:20</TimeStamp>
</Description>';
       type Torque
        ports
         rotation psi out p;
        restrictions
         causality fixed out p;
       end;
       icon ipm bottom
        figures
         line 1141.8 316.2 1128 316.2 color 0 end open;
         line 1141.8 316.2 1132.2 316.2 color 0 end open;
         text 'T' 1147.2 316.2 color 0 14;
         line 1168.5 326.9 1168.5 300.2 color 0 width 2;
         line 1174.4 329 1168.5 323.7 color 0 fill 2005303;
         line 1174.4 323.7 1168.5 318.3 color 0 fill 2005303;
         line 1174.4 318.3 1168.5 313 color 0 fill 2005303;
         line 1174.4 313 1168.5 307.7 color 0 fill 2005303;
         line 1174.4 307.7 1168.5 302.3 color 0 fill 2005303;
         line 1155.7 316.2 1167.4 316.2 color 0 end open;
         line 1155.7 316.2 1163.2 316.2 color 0 end open;
        terminals
         p 1126.4 316.2 fixed;
       end;
       implementation eq
parameters
	real T = 0.0 {N.m};		// Torque
variables
	real hidden omega {rad/s};
equations
	p.T = T;
	omega = p.omega;implementation_end;
     end;
     connections
      Bearing1\p <= DCmotor\p2;
      DCmotor\p1_low => Node1\p;
      Gear\p_in <= Inertia1\p;
      Gear\p_out => Bearing\p;
      Ground\p => Node1\p;
      Inductor\p_low => Resistor\p_high;
      Inertia\p <= Torque\p;
      Inertia\p => Bearing\p;
      Inertia1\p => Bearing1\p;
      ModulatedVoltageSource\p_high => Inductor\p_high;
      Node1\p => ModulatedVoltageSource\p_low;
      PositionSensor\p <= Inertia\p;
      PositionSensor\phi -> phi;
      Resistor\p_low => DCmotor\p1_high;
      u -> ModulatedVoltageSource\u;
     end;
    implementation_end;
   Ramp 248 152
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Ramp.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:1:50</TimeStamp>
</Description>';
    type 'SignalGenerator-Ramp'
     ports
      signal out output;
    end;
    icon bg bottom
     figures
      rectangle 232 136 264 168 color 0 fill 15132390;
      line 234.9 160 261.1 160 color 0;
      line 237.3 159.8 241.7 160.1 255.1 147.4 color 16711680 width 2;
      line 237.1 144 237.1 162.2 color 0;
    end;
    implementation eq
parameters
	real slope = 1 {1/s};
	real start_time = 1.0 {s};
variables
	boolean hidden change;
equations
	"calculate at least at the start time"
	change = timeevent (start_time);

	"calculate the ramp signal"
	output = slope * ramp (start_time);
     implementation_end;
   SignalMonitor 456 424
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
