   LinearSystem1 705 160
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
  <LibraryPath>Signal\Transfer Functions\LinearSystem.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:28:5</TimeStamp>
  <AllowLibraryUpdate>False</AllowLibraryUpdate>
</Description>
';
    type LinearSystem
     ports
      signal in u;
      signal out y;
    end;
    icon bg bottom
     figures
      rectangle 660 143 750 177 color 0 fill 15132390;
      text '0.8333' 681 152 color 8388608;
      text 'z' 699 152 color 0;
      text '+' 709 152 color 0;
      text '0.8333' 733 152 color 8388608;
      text 'z' 683 170 color 0;
      text '+' 693 170 color 0;
      text '0.6667' 717 170 color 8388608;
      line 664 160 748 160 color 9211020;
    end;
    implementation eq
// 20-sim Linear System Editor
// tf h 0.1
parameters
	real hidden A [1, 1] = [-0.6666666666666667];
	real hidden B [1, 1] = [5.2704627669473];
	real hidden C [1, 1] = [0.05270462766947299];
	real hidden D [1, 1] = [0.8333333333333334];
	real hidden x0 [1] = [0.0];
variables
	real x [1];
equations
	next (x, x0) = A * x + B * u;
	y = C * x + D * u;
implementation_end;
   Observer 640 112
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal out output_xhat [3,1];
      signal in input_u;
      signal in input_y;
    end;
    implementation eq
parameters
	real Ad[3,3] = 
	[ 	0.6483,   -0.0041,   -0.0000,
    	0.0391,    0.9999,    0.0006,
    	0.0005,    0.0250,    1.0000];

	real Bd[3] = [0.8115e-3, 0.0207e-3, 0.0002e-3];
	real Cd[1, 3] = [0.0, 0.0, 1.0];
	real Ld[3] = [-0.0002, 0.0195, 0.0367];



variables
	real xhat[3];
	real u;
	real y;

equations
	u = input_u;
	y = input_y;
	xhat = Ad*previous(xhat) + Bd*u + Ld*(y - Cd*previous(xhat));
	output_xhat = xhat;
 implementation_end;
