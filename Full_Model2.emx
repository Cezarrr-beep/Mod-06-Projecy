      I1 1072 704
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Bond Graph\2D\I-2.emx</LibraryPath>
  <TimeStamp>2007-9-25 12:7:37</TimeStamp>
</Description>';
       type 'I-2'
        ports
         power in p [2,1];
         signal out state [2,1];
        restrictions
         causality preferred in p;
       end;
       icon bg ellipse bottom
        figures
         text 'I' 1072 704 color 0 18 bold;
       end;
       implementation eq
parameters
	real global beam1Weight = 0.4;
variables
	real i[2,2];
equations
	 i = [beam1Weight, 0.0; 0.0, beam1Weight];
    state = int(p.e);
    p.f = inverse (i) * state;
implementation_end;
