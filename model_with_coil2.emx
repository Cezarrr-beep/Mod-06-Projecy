</Description>
';
    type LinearSystem
     ports
      signal in u;
      signal out y;
    end;
    icon bg bottom
     figures
      rectangle 646 175 703 209 color 0 fill 15132390;
      text '1' 676 184 color 8388608;
      text '0.01' 662 202 color 8388608;
      text 's' 675 202 color 0;
      text '+' 685 202 color 0;
      text '1' 697 202 color 8388608;
      line 650 192 701 192 color 9211020;
    end;
    implementation eq
// 20-sim Linear System Editor
// tf
parameters
	real hidden A [1, 1] = [-100.0];
	real hidden B [1, 1] = [100.0];
	real hidden C [1, 1] = [1.0];
	real hidden x0 [1] = [0.0];
variables
	real x [1];
equations
	ddt (x, x0) = A * x + B * u;
	y = C * x;
implementation_end;
