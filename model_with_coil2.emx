 type 'Derivative-Default'
  ports
   signal in input;
   signal out output;
 end;
 icon bg bottom
  figures
   rectangle 576 96 608 128 color 0 fill 15132390;
   text 'd/dt' 592 106 color 16711680 13 bold;
   text 'FO' 591 119 color 16711680 13 bold;
 end;
 implementation eq
parameters
	real fh = 100.0 {Hz};		// Differentiation bandwidth [Hz]
	real initial = 0.0;			// Initial output
variables
	real hidden rate;
	real hidden initial_input;
	boolean hidden initialized;
initialequations
	initialized = false;
equations
	if not initialized then 
		initial_input = input; 
		initialized = true;
	end;
	rate  = - 2*pi*fh * output;
	output = 2*pi*fh * (input - initial_input)  + int (rate,initial);                implementation_end;
specification_end;
				specification 'Pure'
