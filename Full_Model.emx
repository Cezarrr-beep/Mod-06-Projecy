      Controller 336 176
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input_x [3,1];
         signal in input_u_ref;
         signal out output_u;
       end;
       implementation eq
parameters
	real K[1, 3] = [1.014737550026210e3, 95.722797767766800, -0.721778283178340];
	real Nbar = -4.590939922261126e3;

variables
	real x[3];
	real u_ref;
	real u;

equations
  	u_ref = input_u_ref;
  	x = input_x;
  	u = -K*x + Nbar*u_ref;
	output_u = u;

implementation_end;
      GaussianNoise 888 288
						specifications active 'unlimited'
							specification 'frequency_limited_FOH'
description '<Description>
   <Version>4.1</Version>
<IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-GaussianNoise.emx</LibraryPath>
  <TimeStamp>2009-6-18 15:42:21</TimeStamp>
<AllowLibraryUpdate>True</AllowLibraryUpdate>
</Description>';
 type 'SignalGenerator-GaussianNoise'
  ports
   signal out output;
 end;
 icon bg bottom
  figures
   group
    rectangle 240 432 272 464 color 0 fill 15132390;
    text 'FOH' 261.7 459 color 0 8 bold;
    line 244.3 443.9 247.2 442.7 248 440 249.3 438.3 250.7 453.5 252.2 455.2 253.5 441.7 254.8 440.8 256.7 451.7 259.5 453.8 261 439.5 262 437.5 263.2 441 263.5 445.2 265.5 446.5 267.9 446.6 color 16711680;
    line 270.1 448 241.3 448 color 0;
    line 244.5 438.4 244.5 457.6 color 0;
   end;
 end;
 implementation eq
parameters
	real amplitude = 1.0;			
	real seed = 0.0;					
	real frequency = 100.0 {Hz};		// hold frequency on output
variables
	real hidden t_hit {s}, h {s}, dt {s};
	real hidden buffer, buffer_hit, slope;		
	boolean hidden hit; 	
initialequations
	h = 1 / frequency;
	t_hit = 0;
	buffer = 0;
	buffer_hit = amplitude * gauss (1,seed);
	slope = (buffer_hit - buffer) / h;
code
	hit = major and (time >= t_hit);
	if hit then
		t_hit = time + h;
		buffer = buffer_hit;
		buffer_hit = amplitude * gauss (1,seed);
		slope = (buffer_hit - buffer) / h;
	end;
	dt = t_hit - time;
	output = if (dt == 0) then 
		buffer 
	else 
		buffer + slope * (h - dt) end;
implementation_end;
specification_end;
							specification 'frequency_limited_ZOH'
description '<Description>
 <Version>4.0</Version>
 <IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
 <LibraryPath>Signal\Sources\SignalGenerator-GaussianNoise.emx</LibraryPath>
