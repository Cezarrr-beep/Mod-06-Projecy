</Description>';
             type DiscreteDifferential
              ports
               signal in input;
               signal out output;
             end;
             icon bg bottom
              figures
               rectangle 464 63.7 496 96.3 color 0 fill 15132390;
               text '-1' 489.3 86 color 16711680 10;
               text 'z' 482.7 89.8 color 16711680 13;
               group
                text 'd' 474.2 72.7 color 16711680 14;
                text 'dt' 474.2 85.8 color 16711680 14;
                line 468.2 79.3 479 79.3 color 16711680;
               end;
             end;
             implementation eq
parameters
	real initial = 0.0;  	// initial output value
variables
	real hidden initial_input;
	boolean hidden initialized;
initialequations
	initialized = false;
equations
	if not initialized then 
		initial_input = initial - input/sampletime; 
		initialized = true;
	else
		initial_input = 0;
	end;
	output = (input - previous (input,0))/sampletime + initial_input;
implementation_end;
