      Saw1 200 504
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\WaveGenerator-Saw.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:11:0</TimeStamp>
</Description>';
       type 'WaveGenerator-Saw'
        ports
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 184.1 488 215.9 520 color 0 fill 15132390;
         line 187.9 491.9 187.9 517.7 color 0 fill 0;
         line 185.7 516.1 211.6 516.1 color 0 fill 0;
         line 187.7 515.7 195.7 504 195.7 516.3 203.9 504 203.9 515.9 211.7 504 211.7 516.3 color 16711680;
       end;
       implementation eq
constants
	real eps = 1e-12;				// force simulation step on the peak and just after the peak 
parameters
	real amplitude = 1.0;			// amplitude of the wave
	real omega = 1 {rad/s};		// angular frequency of the wave
variables
	real hidden period {s};
	boolean hidden change, change2;
equations
	"calculate at least twice each period
	 just before and after the change"
	period = 2.0 * pi / omega;
	change = frequencyevent (period, period*(1+ eps));
	change2 = frequencyevent (period, period*(1 - eps));

	"calculate the saw wave"
	output =  (amplitude / period) * (ramp (0.0) mod period);
implementation_end;
      Sine 200 56
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\WaveGenerator-Sine.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:12:6</TimeStamp>
</Description>';
       type 'WaveGenerator-Sine'
        ports
         signal out output;
       end;
       icon bg bottom
        figures
         group
          rectangle 184 40 216 72 color 0 fill 15132390;
          line 188.5 46.4 188.5 65.6 color 0;
          line 214.1 56 185.3 56 color 0;
          spline 188.9 55.9 192.1 47.8 195.3 55.9 198.6 64 201.7 55.9 204.8 47.8 208.1 55.9 211.6 64.2 214.8 56.2 color 16711680;
         end;
       end;
       implementation eq
parameters
	real amplitude = 1;			// amplitude of the wave
	real omega = 1 {rad/s};		// angular frequency of the wave
variables
	boolean hidden change;
	real hidden half;
equations
	"calculate at least 2 points per cycle to get a triangle"
	half = pi / omega;
	change = frequencyevent (half, half / 2);

	"calculate the sine wave"
	output = amplitude * sin ( omega * time);
implementation_end;
