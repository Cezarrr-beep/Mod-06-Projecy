     connections
      BF_body_center_velocity\p => RTF\p1;
      BF_body_center_velocity\p => ZeroJunction1\p;
      BF_wheel_velocity\p => RTF1\p1;
      Constant\output -> PlusMinus3\plus;
      Demux1\output1 -> xbeam1\input;
      Demux1\output2 -> ybeam1\input;
      Gain\output -> rotation_inverted;
      GY\p2 => OneJunction1\p;
      I\p <= OneJunction1\p;
      I1\p <= RF_body_center_velocity\p;
      I2\p <= OneJunction\p;
      motor -> MSe\effort;
      MSe\p => OneJunction\p;
      OneJunction\flow -> current;
      OneJunction\p => GY\p1;
      OneJunction1\p => OneJunction3\p;
      OneJunction3\flow -> rotBeam1\input;
      OneJunction3\p => OneJunction4\p;
      OneJunction4\p => R2\p;
      OneJunction4\p => TF\p1;
      PlusMinus3\output -> z;
      R1\p <= OneJunction\p;
      RF_body_center_velocity\flow -> Demux1\input;
      rotBeam1\output -> Splitter7\input;
      RTF\p2 => RF_body_center_velocity\p;
      RTF1\p2 => RF_wheel_velocity\p;
      Se_Gravity\p => RF_body_center_velocity\p;
      Sf\p => RF_wheel_velocity\p;
      Splitter3\output -> RTF1\angle 840 496 840 536;
      Splitter3\output -> Splitter4\input;
      Splitter4\output -> RTF\angle 1024 496 1024 536;
      Splitter5\output -> Splitter3\input;
      Splitter7\output -> Splitter5\input;
      Splitter7\output -> Splitter8\input;
      Splitter8\output -> Gain\input;
      Splitter8\output -> rotation 752 312;
      TF\p2 => ZeroJunction1\p;
      xbeam1\output -> x;
      ybeam1\output -> PlusMinus3\plus;
      ZeroJunction1\p => BF_wheel_velocity\p;
     end;
