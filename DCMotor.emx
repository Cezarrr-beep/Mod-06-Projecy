   rotation psi out p_out;
  restrictions
   orientation constraint not_equal p_in p_out;
   causality preferred in p_in;
   causality preferred in p_out;
 end;
 icon ipm bottom
  figures
   line 688 304 744 304;
   line 744 328 776 328;
   rectangle 700.3 287.8 732.3 319.8 fill 13421772;
   text 'J' 715.9 304 15 italic;
   line 740.1 297.5 744.4 297.5 color -1;
   line 739.6 298.5 746 298.5 width 2;
   line 742.8 298.5 742.8 309.2 width 2;
   line 739.6 309.2 746 309.2 width 2;
   line 739.6 312.4 746 312.4 width 2;
   line 742.8 313.3 742.8 344.2 width 2;
   line 739.6 343.3 746 343.3 width 2;
   text '1' 750.7 305.2;
   text 'i' 751.3 319.1 color 16711680;
   group
    line 757.1 325.5 761.3 321.3;
    line 757.1 321.3 761.3 325.5;
    line 763.5 321.3 767.7 325.5;
    line 763.5 325.5 767.7 321.3;
   end;
   group
    line 757.1 334.1 761.3 329.8;
    line 757.1 329.8 761.3 334.1;
    line 763.5 329.8 767.7 334.1;
    line 763.5 334.1 767.7 329.8;
   end;
  terminals
   p_in 688 304 fixed;
   p_out 776 328 fixed;
 end;
 implementation eq
parameters
	real i = 10.0 {};					// gearbox ratio
	real eff = 0.97 {};					// gearbox efficiency (0 < eff <= 1)
	real J = 1.0e-5 {kg.m2/rad};		// rotational inertia
variables
	real p_in_T;
	real dyn_eff;
initialequations
	dyn_eff = eff;
equations
	p_in.omega = (1/J)*int(p_in.T - p_in_T);
	p_out.T = -p_in_T*i*dyn_eff;
	p_out.omega = -p_in.omega/i;
	dyn_eff = if (sign(dly(p_in_T,0.0))*sign(dly(p_in.omega,0.0))) >= 0 then eff else 1/eff end;
implementation_end;
specification_end;
						end;
