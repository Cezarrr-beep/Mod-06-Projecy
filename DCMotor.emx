  figures
   rectangle 424 192 456 224 fill 13421772;
   text 'm' 440 208 15 italic;
   line 429 221 429 205 429 221 start;
   text 'Fg' 430 199 11 italic;
  terminals
   p 440 208;
   p 440 192;
 end;
 implementation eq
parameters
	real m = 1.0 {kg};			// mass
	real g = 9.800665 {m/s2};	// acceleration of gravity
variables
	real interesting x {m};
	real a {m/s2};
equations
	a = (p.F / m) - g;
	p.v = int (a);
	x = int (p.v);

implementation_end;
specification_end;
						end;
