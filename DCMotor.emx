 type Gear
  ports
   rotation psi in p_in;
   rotation psi out p_out;
  restrictions
   orientation constraint not_equal p_in p_out;
   causality constraint not_equal p_in p_out;
 end;
 icon ipm bottom
  figures
   line 80 104 96 104 color 0;
   line 96 128 128 128 color 0;
   line 93.3 96 97.6 96 color -1;
   line 92.8 97 99.2 97 color 0 width 2;
   line 96 97 96 109.2 color 0 width 2;
   line 92.8 109.2 99.2 109.2 color 0 width 2;
   line 92.8 112.8 99.2 112.8 color 0 width 2;
   line 96 111.8 96 146.4 color 0 width 2;
   line 92.8 145.4 99.2 145.4 color 0 width 2;
   text '1' 102.9 102.5 color 0;
   text 'i' 102.9 118.3 color 16711680;
   group
    line 107.1 125.5 111.3 121.3 color 0;
    line 107.1 121.3 111.3 125.5 color 0;
    line 113.5 121.3 117.7 125.5 color 0;
    line 113.5 125.5 117.7 121.3 color 0;
   end;
   group
    line 107.1 134.1 111.3 129.8 color 0;
    line 107.1 129.8 111.3 134.1 color 0;
    line 113.5 129.8 117.7 134.1 color 0;
    line 113.5 134.1 117.7 129.8 color 0;
   end;
  terminals
   p_in 80 104 fixed;
   p_out 128 128 fixed;
 end;
 implementation eq
parameters
	real i = 10.0 {};				// gearbox ratio
	real eff = 0.97 {};			// gearbox efficiency (0 < eff <= 1)
variables
	real dyn_eff;
initialequations
	dyn_eff = eff;
equations
	p_out.T = -p_in.T*i*dyn_eff;
	p_out.omega = -p_in.omega/i;
	dyn_eff = if (sign(dly(p_in.T,0.0))*sign(dly(p_in.omega,0.0))) >= 0 then eff else 1/eff end;
	implementation_end;
specification_end;
