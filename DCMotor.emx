 icon ipm bottom
  figures
   line 688 304 744 304;
   line 744 328 776 328;
   rectangle 700.3 287.8 732.3 319.8 fill 13421772;
   text 'J' 715.9 304 15 italic;
   line 740.1 297.5 744.4 297.5 color -1;
   line 739.6 298.5 746 298.5 width 2;
   line 742.8 298.5 742.8 309.2 width 2;
   line 739.6 309.2 746 309.2 width 2;
   line 739.6 312.4 746 312.4 width 2;
   line 742.8 313.3 742.8 344.2 width 2;
   line 739.6 343.3 746 343.3 width 2;
   text '1' 750.7 305.2;
   text 'i' 751.3 319.1 color 16711680;
   group
    line 757.1 325.5 761.3 321.3;
    line 757.1 321.3 761.3 325.5;
    line 763.5 321.3 767.7 325.5;
    line 763.5 325.5 767.7 321.3;
   end;
   group
    line 757.1 334.1 761.3 329.8;
    line 757.1 329.8 761.3 334.1;
    line 763.5 329.8 767.7 334.1;
    line 763.5 334.1 767.7 329.8;
