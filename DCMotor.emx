 type DCMotor
  ports
   electric delta in p1;
   rotation psi out p2;
  restrictions
   causality constraint equal p1 p2;
 end;
 icon bg bottom
  figures
   line 352 79.5 352 31.5 color 0;
   rectangle 346.7 39.5 357.4 71.5 color 0 fill 0;
   ellipse 339.2 43.2 364.8 68.8 color 0 fill 16777215;
   line 376 56 352 56 color 0 fill 0;
  terminals
   p1 high 352 32 fixed;
   p1 low 352 80 fixed;
   p2 376 56 fixed;
 end;
 implementation eq
parameters
	real k = 1.0 {N.m/A};		// motor constant
equations
	p2.T = k * p1.i;
	p1.u = k * p2.omega;
implementation_end;
specification_end;
							specification 'IR'
description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Iconic Diagrams\Electric\Actuators\DCMotor.emx</LibraryPath>
  <TimeStamp>2008-1-15 15:27:48</TimeStamp>
</Description>';
 type DCMotor
  ports
   electric delta in p1;
   rotation psi out p2;
  restrictions
   causality constraint equal p1 p2;
 end;
 icon bg bottom
  figures
   line 120 567.5 120 519.5;
   rectangle 114.7 527.5 125.4 559.5 fill 0;
   ellipse 107.2 531.2 132.8 556.8 fill 16777215;
   line 144 544 120 544 fill 0;
  terminals
   p1 high 120 520 fixed;
   p1 low 120 568 fixed;
   p2 144 544 fixed;
 end;
 implementation eq
parameters
	real k = 0.01 {N.m/A};		// motor constant
	real L = 1e-3  {H};			// inductance
	real R = 2  {ohm};			// resistance
variables
	real hidden ur {V};
	real hidden ui {V};
	real hidden um {V};
equations
	p1.i = (1/L)*int(ui,0);
	ur = R*p1.i;
	p2.T = k * p1.i;
	um = k * p2.omega;
	ui = p1.u - ur - um;implementation_end;
specification_end;
						end;
