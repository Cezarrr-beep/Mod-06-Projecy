</Description>';
    knot PlusMinus
     ports
      signal knot duplicatable in plus [1];
      signal knot duplicatable in minus [1];
      signal knot out output [1];
    end;
    icon bg ellipse
     figures
      ellipse 272 216 288 232 color 0 fill 16777215;
    end;
    implementation eq
equations
    output = sum (collect (plus)) - sum (collect (minus));
    implementation_end;
  end;
  connections
   Constant\output -> PlusMinus\plus;
   Gain\output -> model\INPUT;
   model\OUTPUT -> PlusMinus\minus;
   PlusMinus\output -> Gain\input;
  end;
 implementation_end;
