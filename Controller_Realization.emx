      Controller1 376 248
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input_x [4,1];
         signal in input_u_ref;
         signal out output_u;
         signal in input_y;
       end;
       implementation eq
parameters
	real Kx[1, 4] = [-0.017561675596780,-10.230431981097157,8.672971455200084e+02,1.844603452263951e+02];

variables
	real x[4];
	real u_ref;
	real u;
	real z;
	real y;

equations
  	u_ref = input_u_ref;
	y = input_y;
	x = input_x;
	
	z = previous(z) + 0.001*(u_ref - y);
  	u = -Kx * x + 0;

	output_u = u;
implementation_end;
