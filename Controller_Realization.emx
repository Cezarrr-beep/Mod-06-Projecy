</Description>
</Information>';
 type 'Switch-Default'
  ports
   signal in input_high [2,1];
   signal in condition;
   signal out output [2,1];
 end;
 icon bg bottom
  figures
   rectangle 592 248 624 280 color 0 fill 15132390;
   ellipse 611 261.3 615 265.7 color 16711680;
   ellipse 599.5 270.1 603.6 274.1 color 16711680;
   line 604.4 270.2 610.8 265.2 color 16711680 width 2;
   line 615 263.8 621.8 263.8 color 16711680 width 2;
   line 595.2 254 599.4 254 color 16711680 width 2;
   line 595.1 272.1 599.3 272.1 color 16711680 width 2;
   ellipse 599.7 251.9 603.4 255.7 color 16711680;
   line 609.6 273.1 610.9 270.4 612.5 273.4 612.5 273.4 color 16711680 fill 16711680 open;
   line 610.7 277.3 610.9 271.3 color 16711680 open;
  terminals
   input_high 592 256 fixed;
   condition 608 280 fixed;
   output 624 264 fixed;
 end;
 implementation eq
equations
	output = if abs(condition) <= 1.0 then
		input_high
	else
			[0.0; 0.0]
	end;        implementation_end;
specification_end;
						end;
