      Sweep 816 232
						specifications active 'default'
							specification 'default'
 description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Sweep.emx</LibraryPath>
  <TimeStamp>2008-1-24 10:10:10</TimeStamp>
</Description>';
 type 'SignalGenerator-Sweep'
  ports
   signal out output;
 end;
 icon bg bottom
  figures
   rectangle 800 216 832 248 color 0 fill 15132390;
   line 804.5 222.4 804.5 241.6 color 0;
   line 830.1 232 801.3 232 color 0;
   spline 804.5 232 808.2 227.9 812.5 224.2 817.3 242.1 820.3 222.6 822.9 242.3 825.3 222.4 827.2 242.3 828.5 222.4 829.5 242.3 color 16711680;
 end;
 implementation eq
parameters
	real amplitude = 1.0 {};
	real start_time = 0.0 {s};
	real stop_time = 10.0 {s};
	real omega_start = 0.0 {frequency, rad/s};
	real omega_stop = 5 {frequency, rad/s};
variables
	real omega {frequency, rad/s};		// current frequency {rad/s}
	real hidden t;
	real hidden dw;
	real hidden dt;
	real hidden dwdt;
	real hidden dwdt2;
	boolean hidden change;
initialequations
	dw = omega_stop - omega_start;
	dt = stop_time - start_time;
	dwdt = dw/dt;
	dwdt2 = dwdt/2;
equations
	"calculate at least at the start and stop time"
	change = timeevent (start_time) or timeevent (stop_time);
	t = if time < start_time then 
		0  
	else
		if time > stop_time then
			0
		else
			time - start_time
		end	
	end; 
	omega = omega_start + t * dwdt;
	output = amplitude*sin( t * ( omega_start + t * dwdt2  )  ); implementation_end;
specification_end;
							specification 'Logarithmic'
description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Sweep.emx</LibraryPath>
  <TimeStamp>2008-1-24 10:10:10</TimeStamp>
</Description>';
 type 'SignalGenerator-Sweep'
  ports
   signal out output;
 end;
 icon bg bottom
  figures
   rectangle 120 294.9 152 327.4 fill 15132390;
   line 124.5 297.7 124.5 317.2;
   line 150.1 308.5 121.3 308.5;
   spline 124.5 307.4 128.2 303.2 132.5 299.5 137.3 317.7 140.3 297.8 142.9 317.8 145.3 297.7 147.2 317.8 148.5 297.7 149.5 317.8 color 16711680;
   text 'log' 137.6 322 color 16711680;
 end;
 implementation eq
parameters
	real amplitude = 1.0 {};
	real start_time = 0.0 {s};
	real stop_time = 10.0 {s};
	real omega_start = 0.0 {frequency, rad/s};
	real omega_stop = 62.8318530718 {frequency, rad/s};
variables
	real omega {frequency, rad/s};		// current frequency (rad /s)
	real hidden t;
	real hidden dw;
	real hidden dt;
	real hidden dwdt;
	real hidden base;
	boolean hidden change;
initialequations
	dw = omega_stop - omega_start;
	dt = stop_time - start_time;
	base = exp(log(dw)/dt);
	dwdt = dw/dt;
equations
	"calculate at least at the start and stop time"
	change = timeevent (start_time) or timeevent (stop_time);
	t = if time < start_time then 
		0  
	else
		if time > stop_time then
			0
		else
			time - start_time
		end	
	end; 
	omega = omega_start + dw*base^t / (base^dt*(1 + dt*log(base)))+ t*dw*base^t*log(base) / (base^dt*(1 + dt*log(base)));
	output = amplitude*sin( t * ( omega_start +  (dw*base^t)/( base^dt*(1+dt*log(base)))   )  ); implementation_end;
specification_end;
							specification 'ZeroMean'
description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Sweep.emx</LibraryPath>
  <TimeStamp>2008-1-24 10:10:10</TimeStamp>
</Description>';
 type 'SignalGenerator-Sweep'
  ports
   signal out output;
 end;
 icon bg bottom
  figures
   rectangle 120 294.9 152 327.4 fill 15132390;
   line 124.5 297.6 124.5 317.1;
   line 150.1 308.5 121.3 308.5;
   spline 124.5 307.4 128.2 303.2 132.5 299.5 137.3 317.6 140.3 297.8 142.9 317.8 145.3 297.6 147.2 317.8 148.5 297.6 149.5 317.8 color 16711680;
   text 'zero' 134.4 322 color 16711680;
 end;
 implementation eq
parameters
	real amplitude = 1.0 {};
	real start_time = 0.0 {s};
	real stop_time = 10.0 {s};
	real omega_start = 0.0 {frequency, rad/s};
	real omega_stop = 62.8318530718 {frequency, rad/s};
variables
	real omega {frequency, rad/s};		// current frequency (rad /s)
	real hidden t;
	real hidden dw;
	real hidden dt;
	real hidden dwdt;
	real hidden dwdt2;
	real hidden tc;
	real hidden correction;
	boolean hidden change;
initialequations
	dw = omega_stop - omega_start;
	dt = stop_time - start_time;
	dwdt = dw/dt;
	dwdt2 = dwdt/2;
	tc = start_time + ( -omega_start + sqrt(omega_start^2 + 8*pi*dwdt2) ) / dwdt ;
equations
	"calculate at least at the start and stop time"
	change = timeevent (start_time) or timeevent (stop_time);
	t = if time < start_time then 
		0  
	else
		if time > stop_time then
			0
		else
			time - start_time
		end	
	end;
	omega = omega_start + t * dwdt;
	correction = ((ramp(start_time) - ramp(tc))/(tc-start_time))^2.8715;
	output = correction*amplitude*sin( t * ( omega_start + t * dwdt2  )  ); implementation_end;
specification_end;
						end;
     end;
     connections
      Controller\output -> SignalLimiter2\input;
      Distance_L -> Splitter5\input;
      Distance_R -> Splitter6\input;
      Negate1\output -> SignalMonitor\input;
      SignalLimiter1\output -> Input_L;
      SignalLimiter2\output -> Input_R 976 88;
      Splitter5\output -> Controller\input;
      Splitter5\output -> input_signal_monitor\input;
      Splitter6\output -> Controller\minus;
      Splitter6\output -> Negate1\input;
      Sweep\output -> SignalLimiter1\input;
     end;
    implementation_end;
