      Controller 296 176
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input_x [3,1];
         signal in input_u_ref;
         signal out output_u;
         signal in input_y;
       end;
       implementation eq
parameters
	real Kx[1, 3] = [-1.655615460129033e+08,-1.760583680349668e+04,1.226826400322220e+08];
	real Ki = -7.276596669035497;

variables
	real x[3];
	real u_ref;
	real u;
	real z;
	real y;

equations
  	u_ref = input_u_ref;
	y = input_y;
	x = input_x;
	
	z = z + (u_ref - y);
  	u = -Kx * x - Ki * z;

	output_u = u;
implementation_end;
      Cycloid 200 176
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Cycloid.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:0:53</TimeStamp>
</Description>';
       type 'SignalGenerator-Cycloid'
        ports
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 184 160 216 192 color 0 fill 15132390;
         line 186.9 184 213.1 184 color 0;
         line 189.1 168 189.1 186.2 color 0;
         spline 189 184 193.8 182.1 200.2 172.8 212.3 170.7 color 16711680 fill 15132390;
         line 209.8 184 209.8 170.7 color 0 fill 15132390 dotted;
       end;
       implementation eq
parameters
	real amplitude = 0.01 {none};
	real start_time = 1.0 {s};
	real stop_time = 2.0 {s};
variables 
	real hidden tDelta, cycl;
	boolean hidden change;
equations
	"calculate at least at the start and stop time"
	change = timeevent (start_time) or timeevent (stop_time);

	"calculate the cycliod signal"
	tDelta = 2 * pi * (time - start_time) / (stop_time - start_time);
	cycl = amplitude * (tDelta - sin (tDelta)) / twopi;
	output = if tDelta < 0.0 then 
		0
	else
		if tDelta >= 0.0 and tDelta <= twopi then
			cycl
		else
			amplitude
		end
	end;
implementation_end;
      LinearSystem 544 240
       type LinearSystem
        ports
         signal in u;
         signal out y;
       end;
       icon bg
        figures
         rectangle 529 225 559 255 color 0 fill 15132390;
         text 'A B' 544 233 color 16711680 bold;
         text 'C D' 544 246 color 16711680 bold;
       end;
       implementation eq
// 20-sim Linear System Editor
// abcd h 0.001
parameters
	real hidden A [3, 3] = [1.0000055557074674, 1.4077469779677672e-4, -0.03724946297922129; 0.33557140196434015, 1.000023619915738, -0.006249909895842499; 9.371882804452956e-7, 2.374718210590495e-5, 0.9497320350096172];
	real hidden B [3, 1] = [-0.0012422683821324072; -2.0843429230409523e-4; -0.0016764350019361567];
	real hidden C [1, 3] = [0.005305849739116081, 0.03162315006534316, -9.88197522084401e-5];
	real hidden D [1, 1] = [-3.2956355308312313e-6];
	real hidden x0 [3] = [0.0; 0.0; 0.0];
variables
	real x [3];
equations
	next (x, x0) = A * x + B * u;
	y = C * x + D * u;
implementation_end;
      Observer 416 176
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal out output_xhat [3,1];
         signal in input_u;
         signal in input_y;
       end;
       implementation eq
parameters
			real Ad[3,3] = 
		[1.001000505751601,	1.409151022421627e-07,	-3.728579446901374e-05;
		3.359071461078011e-04,	1.001000523833825,	-6.262261841557294e-06;
		9.420907188797260e-10,	2.377034406409912e-08,	1.000950183173196];

	real Bd[3] = [-1.242858498112032e-06;-2.087418748599062e-07;-1.677231339091082e-06];
	real Cd[1, 3] = [0.005305849739116,0.031623150065343,-9.881975220844010e-05];
	real Ld[3] = [0.401300380575141, 0.062887114628014, -72.905516995984680];

variables
	real xhat[3];
	real u;
	real y;

equations
	u = input_u;
	y = input_y;
	xhat = Ad*previous(xhat) + Bd*u + Ld*(y - Cd*previous(xhat));
	output_xhat = xhat;
 implementation_end;
