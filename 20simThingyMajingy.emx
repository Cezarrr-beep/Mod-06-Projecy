            pendulum_mass1 1192 432
             description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\2D\I-2.emx</LibraryPath><TimeStamp>2007-9-25 12:7:37</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
             type 'I-2'
              ports
               power in p [2,1];
               signal out state [2,1];
              restrictions
               causality preferred in p;
             end;
             icon bg ellipse bottom
              figures
               text 'I' 1192 432 color 0 18 bold;
             end;
             implementation eq
parameters
	real global beam2Weight = 0.154;
variables
	real i[2,2];
equations
	 i = [beam2Weight, 0.0; 0.0, beam2Weight];
    state = int(p.e);
    p.f = inverse (i) * state;
implementation_end;
            pendulum_rotational_inertia1 1096 -72
             description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\I.emx</LibraryPath><TimeStamp>2011-11-29 15:55:55</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
             type I
              ports
               power in p;
               signal out state;
               signal out output1;
              restrictions
               causality preferred in p;
             end;
             icon bg ellipse bottom
              figures
               text 'I' 1096 -72 color 0 18 bold;
             end;
             implementation eq
parameters
	real i = 0.0135;
equations
    state = int(p.e);
    p.f = state / i;
implementation_end;
