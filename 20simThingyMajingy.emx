</Description>';
       knot Splitter
        ports
         signal knot duplicatable out output [1];
         signal knot in input [1];
       end;
       icon bg ellipse
        figures
         ellipse 676.8 172.8 683.2 179.2 color -1 fill 0;
         ellipse 675.7 171.7 684.3 180.3 color -1;
        terminals
         input 680 176 fixed;
       end;
       implementation eq
equations
    collect (output) = input;
implementation_end;
     end;
