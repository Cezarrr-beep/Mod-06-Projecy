    implementation_end;
      PulseWave 448 312
       description '<Information>
   <Description>
     <Version>4.9</Version>
     <IsMainModel>1</IsMainModel>
     <KeepParameterValues>False</KeepParameterValues>
     <LibraryPath>Signal\Sources\WaveGenerator-Pulse.emx</LibraryPath>
     <TimeStamp>2021-9-24 11:02:45</TimeStamp>
     <AllowLibraryUpdate>True</AllowLibraryUpdate>
     <Description></Description>
     <Author>Frank Groen</Author>
     <Company>Controllab Products B.V.</Company>
     <ModelVersion>
       <MajorVersion>2</MajorVersion>
       <MinorVersion>0</MinorVersion>
       <PatchVersion>0</PatchVersion>
     </ModelVersion>
  </Description>
</Information>
';
       type 'WaveGenerator-VariableTimeSquare'
        ports
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 432 296 464 328 color 0 fill 15132390;
         line 435.8 300.5 435.9 326.2 color 0 fill 0;
         line 433.9 324.1 459.9 324.1 color 0 fill 0;
         line 435.3 324.1 442 324 442 312 color 16711680 fill 0;
         line 446.7 324.1 446.7 312 446.7 324.1 color 16711680 fill 0;
         line 456 312 456 324.1 456 312 color 16711680 fill 0;
         line 460.2 312.1 456 312.1 color 16711680 fill 0;
         line 447.5 324.2 455.5 324.2 color 16711680 fill 0;
         line 460.2 324.4 460.2 312.3 460.2 324.4 color 16711680 fill 0;
         line 446.4 312.2 442.2 312.2 color 16711680 fill 0;
       end;
       implementation eq
parameters
	real interval = 5.0 {s};
	real pulselength = 0.1 {s};
	real amplitude = 10.0;			// amplitude of the pulse
variables
	real hidden x;						// x changes between 1 and 0
	real hidden nextTime;
	boolean hidden timetrigger;
initialequations
	if pulselength >= interval then stopsimulation ('pulse length should be smaller than interval'); end;
	x = 0.0;
	nextTime = time + interval - pulselength;
code
	timetrigger = timeevent(nextTime);

	if( timetrigger ) then
		if x == 0.0 then
			// give the negated value of x to the output
			x = 1.0;
			// and determine the next time
			nextTime = time + pulselength;
		else
			// give the negated value of x to the output
			x = 0.0;
			// and determine the next time
			nextTime = time + interval - pulselength;
		end;
	end;

	// and calculate the output
	output = amplitude * x;
implementation_end;
