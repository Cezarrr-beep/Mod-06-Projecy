      Controller 296 176
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input_x [4,1];
         signal out output_u;
         signal in input_y;
         signal in input_refx [4,1];
       end;
       implementation eq
parameters
	real Kx[1, 4] = [-0.004446585022655,-10.243088908598255,8.221911228422435e+02,63.496275148986850];

variables
	real x[4];
	real refx[4];
	real u;
	real z;
	real y;

equations
  	refx = input_refx;
	x = input_x;
	y = input_y;
	

  	u = -Kx * (x - refx);

	output_u = u;
implementation_end;
